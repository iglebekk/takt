{
    "mcpServers": {
        "laravel-boost": {
            "command": "php",
            "args": [
                "artisan",
                "boost:mcp"
            ]
        },
        "takt-calendar": {
            "command": "php",
            "args": [
                "${CLAUDE_PROJECT_DIR:-.}/artisan",
                "mcp:start",
                "calendar"
            ]
        }
    }
}
